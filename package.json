{
  "name": "sentineli",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "cd contracts/vault && cargo near build non-reproducible-wasm && cd ../registry && cargo near build non-reproducible-wasm",
    "test:contracts": "cd contracts && cargo test",
    "test": "pnpm -r test",
    "test:sandbox": "pnpm --filter @sentineli/preflight test:sandbox",
    "typecheck": "pnpm -r typecheck",
    "demo:attack": "node demo/attack/run.ts",
    "dev:chain": "node demo/attack/dev-chain.ts",
    "web": "pnpm --filter @sentineli/web dev"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2"
}
